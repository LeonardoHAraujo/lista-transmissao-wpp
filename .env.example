# AWS
SQS_ENDPOINT=
DEPLOYMENT_BUCKET=

# Z-API
Z_API_INSTANCE_ID=
Z_API_INSTANCE_TOKEN=
Z_API_SECURITY_TOKEN=
Z_API_BASE_URL=

# Group broadcast webhook
# Secret used in POST /webhooks/z-api/received/{Z_API_WEBHOOK_SECRET}
Z_API_WEBHOOK_SECRET=
# WhatsApp group id that triggers the broadcast (example: 120363019502650977-group)
SOURCE_GROUP_ID=
# One or more native Z-API broadcast list ids, comma-separated (example: 1779474934@broadcast,1779475000@broadcast)
BROADCAST_IDS=
# Skip messages sent by the connected number. Set to false when the source post is sent by that number.
IGNORE_FROM_ME=true
# Optional allowlist of group participants (E.164, comma-separated). Empty means any participant.
ALLOWED_PARTICIPANT_PHONES=

# Auth token
AUTH_TOKEN=
